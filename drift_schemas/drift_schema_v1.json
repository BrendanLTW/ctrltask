    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 40), \"description\" TEXT NULL CHECK(LENGTH(\"description\") <= 300), \"color_key\" TEXT NOT NULL CHECK(\"color_key\" IN ('orange', 'yellow', 'green', 'blue', 'purple', 'pink', 'red', 'grey')), \"icon_key\" TEXT NOT NULL CHECK(\"icon_key\" IN ('globe', 'chart', 'home', 'code', 'plane', 'briefcase', 'bag', 'book', 'box', 'gift', 'palette', 'heart')), \"deadline\" TEXT NULL, \"archived_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "repeat_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"repeat_rules\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('daily', 'weekdays', 'weekly', 'monthly', 'custom')), \"weekdays\" INTEGER NOT NULL DEFAULT 0 CHECK(\"weekdays\" BETWEEN 0 AND 127), \"day_of_month\" INTEGER NULL CHECK(\"day_of_month\" BETWEEN 1 AND 31), \"interval\" INTEGER NULL CHECK(\"interval\" BETWEEN 1 AND 12), \"unit\" TEXT NULL CHECK(\"unit\" IN ('day', 'week', 'month')), \"ends_on\" TEXT NULL, CHECK (kind != 'weekly' OR weekdays > 0), CHECK (kind != 'monthly' OR day_of_month IS NOT NULL), CHECK (kind != 'custom' OR (interval IS NOT NULL AND unit IS NOT NULL)), CHECK (unit IS NOT 'month' OR day_of_month IS NOT NULL));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL CHECK(LENGTH(\"title\") BETWEEN 1 AND 120), \"description\" TEXT NULL CHECK(LENGTH(\"description\") <= 1000), \"due_date\" TEXT NULL, \"due_minute\" INTEGER NULL CHECK(\"due_minute\" BETWEEN 0 AND 1439), \"priority\" TEXT NOT NULL CHECK(\"priority\" IN ('urgent', 'high', 'medium', 'low')), \"project_id\" INTEGER NULL REFERENCES projects (id) ON DELETE SET NULL, \"status\" TEXT NOT NULL CHECK(\"status\" IN ('open', 'done')), \"completed_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"board_column\" TEXT NOT NULL CHECK(\"board_column\" IN ('todo', 'doing', 'done')), \"sort_order\" INTEGER NOT NULL, \"repeat_rule_id\" INTEGER NULL REFERENCES repeat_rules (id) ON DELETE SET NULL, \"reminder\" TEXT NOT NULL DEFAULT 'none' CHECK(\"reminder\" IN ('none', 'atTime', 'min10', 'min30', 'hour1', 'morningOf', 'dayBefore')), CHECK (due_minute IS NULL OR due_date IS NOT NULL), CHECK ((status = 'done') = (board_column = 'done')));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL CHECK(LENGTH(\"title\") BETWEEN 1 AND 120), \"done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"done\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
