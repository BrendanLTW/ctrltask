      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") BETWEEN 1 AND 24) UNIQUE, CHECK (name = lower(name) AND instr(name, '#') = 0));"
        }
      ]
    },
